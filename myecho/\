use std::env ;

fn main() {
    let args: Vec<String> = env::args().collect();


    for a in &args{
        println!("args: {a}");
    }
       for i in 1..args.len() { 
           if i != args.len() - 1 {
               print!("{} ", args[i]);
           } else {
           print!("{}", args[i]);
       }
    
       }
       println!();
}

